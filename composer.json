{
    "name": "cribops/cribops-wp-kit",
    "description": "WordPress site management and deployment toolkit with CDN integration",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.371.4",
        "guzzlehttp/guzzle": "^8.0.1",
        "mtdowling/jmespath.php": "^2.9.1"
    },
    "autoload": {
        "psr-4": {
            "CribOps\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.2"
        }
    }
}
